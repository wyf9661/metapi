# Meta API Hub - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Admin authentication token (required, change this!)
AUTH_TOKEN=change-me-admin-token

# Downstream clients authenticate with per-project API keys created in the
# UI (System Settings -> Downstream API Keys). There is no global proxy token.
PORT=4000
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto check-in cron (default: 8:00 AM every day)
CHECKIN_CRON=0 8 * * *

# Balance refresh cron (default: every hour)
BALANCE_REFRESH_CRON=0 * * * *
